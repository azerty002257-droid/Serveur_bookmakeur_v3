# Copiez ce fichier en .env et renseignez vos valeurs

# Port d'ecoute du serveur
PORT=3000

# Cle d'API du fournisseur de cotes (https://the-odds-api.com/)
# Laissez vide pour utiliser le MODE DEMO (donnees simulees)
ODDS_API_KEY=

# Sport suivi (ex: soccer_epl, soccer_france_ligue_one, basketball_nba)
SPORT_KEY=soccer_france_ligue_one

# Region des cotes (eu, uk, us, au)
ODDS_REGION=eu

# Intervalle de rafraichissement des cotes en secondes
REFRESH_INTERVAL=15

# Cle partagee que votre application doit envoyer pour s'authentifier
CLIENT_API_KEY=change-me-please
